# CreditFlow — copy to .env and fill in. .env is gitignored.

# --- PostgreSQL ---
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=creditflow
RABBITMQ_PASS=creditflow
RABBITMQ_URL=amqp://creditflow:creditflow@rabbitmq:5672/

# --- MongoDB ---
MONGO_USER=creditflow
MONGO_PASS=creditflow
MONGO_URL=mongodb://creditflow:creditflow@mongo:27017/

# --- JWT (RS256) ---
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_ISSUER=creditflow-auth
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- Platform SuperAdmin (spec §8 Service 13) ---
# Comma-separated emails. Reconciled into auth.users.is_superadmin on Auth
# startup, in BOTH directions: a listed address is granted the role, and an
# address removed from the list is demoted and its live sessions revoked.
# Empty (the default) means the platform has no SuperAdmin. No API can set
# this — deploy config is the only grant path.
SUPERADMIN_EMAILS=

# --- Credits pricing ---
# AI generation cost: ceil(total_tokens / 1000) * CREDITS_PER_1K_TOKENS,
# minimum 1 credit per metered generation.
CREDITS_PER_1K_TOKENS=1
# Free-plan starter grant: credits handed to every account the first time
# account.created is consumed, once per account, ever. Without it a new
# account starts at 0 and its first generation overdraws. 0 disables the
# free tier.
CREDITS_STARTER_GRANT=100

# --- Third-party (fill in as you build each service) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME
RESEND_API_KEY=REPLACE_ME

# --- Scraper engine (compose falls back to these same defaults if unset) ---
SCRAPER_USER_AGENT=CreditFlowScraper/0.1
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_TIMEOUT_SECONDS=30

# --- API Gateway ---
# Comma-separated allowed browser origins ("*" for dev; set the frontend
# origin, e.g. http://localhost:5173, to narrow it).
GATEWAY_CORS_ORIGINS=*
# Per-client-IP requests/minute at the gateway (0 disables).
GATEWAY_RATE_LIMIT_PER_MINUTE=120
